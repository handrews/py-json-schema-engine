{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bench.example/api-payload",
  "type": "object",
  "required": ["id", "kind", "createdAt", "attributes"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": ["order", "invoice", "shipment", "refund"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "uniqueItems": true,
      "maxItems": 16
    },
    "attributes": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["pending", "settled", "failed", "cancelled"]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "notes": {
          "type": "string",
          "maxLength": 280
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "lineItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku", "quantity", "unitPrice"],
        "additionalProperties": false,
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{4,20}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "type": "number",
            "minimum": 0
          },
          "discount": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
